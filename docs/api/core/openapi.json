{
  "openapi": "3.1.0",
  "info": {
    "title": "Core nguyên mẫu",
    "version": "0.3.0",
    "description": "GET /health/ready là hợp đồng readiness hiện có. Các operation UC-01 và UC-02 là hợp đồng thiết kế cho bước triển khai UC."
  },
  "paths": {
    "/health/ready": {
      "get": {
        "operationId": "getCoreReadiness",
        "responses": {
          "200": {
            "description": "Kết nối DB thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "database": "ok"
                }
              }
            }
          },
          "503": {
            "description": "DB không sẵn sàng",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "unavailable",
                  "database": "unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sessions": {
      "post": {
        "operationId": "createGoogleSession",
        "summary": "Cấp phiên Core từ ID token của Google",
        "description": "Khách gửi ID token qua HTTPS khi dùng xác thực thật. Core kiểm chữ ký, issuer, audience và hạn token trước khi ghi tài khoản, hồ sơ hoặc phiên. Core định danh tài khoản theo Google sub đã xác minh và đồng bộ hồ sơ khi cấp phiên. Khi thử lại, gửi cùng attemptId, ID token gốc và loại thiết bị trong hạn token. Một lượt chỉ cấp tối đa một phiên dùng được. Lượt lặp hợp lệ trả cùng mã phiên còn hiệu lực và không cập nhật hoạt động phiên. Khi token gốc hết hạn, chọn lại tài khoản và dùng attemptId mới.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGoogleSessionRequest"
              },
              "example": {
                "idToken": "example-google-id-token",
                "deviceType": "android",
                "attemptId": "7c03b01b-c3ef-43ec-9dbd-d60ea6d5b39f"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã cấp phiên hoặc trả lại kết quả của cùng lượt còn hiệu lực.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/AuthNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleSession"
                },
                "example": {
                  "accountId": "example-account",
                  "expiresAt": "2030-02-01T12:00:00Z",
                  "sessionToken": "example-core-session-token"
                }
              }
            }
          },
          "400": {
            "description": "Body sai schema hoặc Google ID token bị từ chối, kể cả token hết hạn.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/AuthError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "INVALID_REQUEST",
                            "GOOGLE_TOKEN_REJECTED"
                          ]
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST"
                    }
                  },
                  "GOOGLE_TOKEN_REJECTED": {
                    "value": {
                      "code": "GOOGLE_TOKEN_REJECTED"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Lượt đã ràng buộc với đầu vào khác hoặc phiên của lượt đã mất hiệu lực.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/AuthError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "LOGIN_ATTEMPT_CONFLICT"
                          ]
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "LOGIN_ATTEMPT_CONFLICT": {
                    "value": {
                      "code": "LOGIN_ATTEMPT_CONFLICT"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/AuthUnavailable"
          }
        }
      }
    },
    "/auth/sessions/current/validate": {
      "post": {
        "operationId": "validateCurrentSession",
        "summary": "Xác minh phiên hiện tại khi mở lại ứng dụng",
        "description": "Core suy ra tài khoản từ mã phiên Bearer. Xác minh thành công được tính là hoạt động của phiên và expiresAt phản ánh mốc hết hạn sau lần gọi này. Phiên bị từ chối ngay tại mốc hết hạn theo đồng hồ Core. Yêu cầu đến muộn không hồi sinh phiên đã hết hạn hoặc đã bị thu hồi. Mobile chỉ mở màn hình chính sau khi xác minh thành công.",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Phiên còn hiệu lực.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/AuthNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                },
                "example": {
                  "accountId": "example-account",
                  "expiresAt": "2030-02-01T12:00:00Z"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidCoreSession"
          },
          "503": {
            "$ref": "#/components/responses/AuthUnavailable"
          }
        }
      }
    },
    "/auth/sessions/current": {
      "delete": {
        "operationId": "revokeCurrentSession",
        "summary": "Thu hồi phiên hiện tại",
        "description": "Core chỉ thu hồi phiên được nhận diện bằng mã Bearer. Khi gửi lại cùng mã khớp bản ghi đã thu hồi còn được giữ, Core xác nhận bằng 204. Ngoại lệ này chỉ áp dụng cho thao tác thu hồi. Các phiên khác của cùng tài khoản tiếp tục hoạt động.",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "Đã thu hồi phiên hiện tại hoặc xác nhận phiên này đã được thu hồi."
          },
          "401": {
            "$ref": "#/components/responses/InvalidCoreSession"
          },
          "503": {
            "$ref": "#/components/responses/AuthUnavailable"
          }
        }
      }
    },
    "/me/profile": {
      "get": {
        "operationId": "getMyProfile",
        "summary": "Đọc hồ sơ của tài khoản trong phiên hiện tại",
        "description": "Core lấy tài khoản từ mã phiên Bearer. Dùng HTTPS với thông tin xác thực thật. Lần đọc thành công được tính là hoạt động phiên. Yêu cầu đến muộn không hồi sinh phiên đã hết hạn hoặc bị thu hồi. Trả tên, email và URL ảnh đã đồng bộ từ Google ở lần đăng nhập thành công gần nhất. Nếu avatarUrl là null hoặc URL ảnh không tải được, ứng dụng hiển thị ảnh thay thế.",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Hồ sơ của tài khoản gắn với phiên.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/AuthNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyProfile"
                },
                "examples": {
                  "withAvatar": {
                    "summary": "Hồ sơ có URL ảnh đại diện",
                    "value": {
                      "displayName": "Minh Anh",
                      "email": "minh.anh@example.com",
                      "avatarUrl": "https://media.example.com/avatars/example-profile.jpg"
                    }
                  },
                  "withoutAvatar": {
                    "summary": "Hồ sơ dùng ảnh đại diện thay thế",
                    "value": {
                      "displayName": "Gia Hân",
                      "email": "gia.han@example.com",
                      "avatarUrl": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidCoreSession"
          },
          "503": {
            "$ref": "#/components/responses/MyReadUnavailable"
          }
        }
      }
    },
    "/me/items": {
      "get": {
        "operationId": "listMyItems",
        "summary": "Đọc một trang Mục của tôi",
        "description": "Core lấy tài khoản từ mã phiên Bearer. Dùng HTTPS với thông tin xác thực thật. Lần đọc thành công được tính là hoạt động phiên. Yêu cầu đến muộn không hồi sinh phiên đã hết hạn hoặc bị thu hồi. Lost và Found chỉ gồm bài do tài khoản đó đăng. Trong thực nghiệm, claims gồm yêu cầu do tài khoản gửi hoặc gửi đến bài của họ, mỗi yêu cầu một lần. Trạng thái hiển thị lấy từ fixture. Found chỉ tham chiếu thumbnail đã xử lý riêng tư. Khi bản xử lý chưa có, bỏ trường thumbnailUrl để app dùng ảnh thay thế. Core xác minh phiên và lọc quyền ở mỗi trang. Sắp theo thời điểm tạo giảm dần rồi ID giảm dần. Lấy 20 mục mỗi lần nếu còn đủ, với nextCursor là null khi hết dữ liệu. Bỏ cursor để xem trang đầu hoặc làm mới. Khi tải tiếp, gửi nextCursor cùng tab. Core đọc tiếp theo mốc sắp xếp của cursor kể cả khi mục tại mốc đã bị gỡ. Bài mới ở đầu xuất hiện khi làm mới.",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "parameters": [
          {
            "name": "tab",
            "in": "query",
            "required": true,
            "description": "Loại danh sách cần đọc.",
            "schema": {
              "type": "string",
              "enum": [
                "lost",
                "found",
                "claims"
              ]
            },
            "examples": {
              "lost": {
                "summary": "Bài báo mất",
                "value": "lost"
              },
              "found": {
                "summary": "Bài báo nhặt",
                "value": "found"
              },
              "claims": {
                "summary": "Yêu cầu nhận đồ",
                "value": "claims"
              }
            }
