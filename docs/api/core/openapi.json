{
  "openapi": "3.1.0",
  "info": {
    "title": "Core nguyên mẫu",
    "version": "0.1.0"
  },
  "paths": {
    "/health/ready": {
      "get": {
        "operationId": "getCoreReadiness",
        "responses": {
          "200": {
            "description": "Kết nối DB thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "database": "ok"
                }
              }
            }
          },
          "503": {
            "description": "DB không sẵn sàng",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "unavailable",
                  "database": "unavailable"
                }
              }
            }
          }
        }
      }
    }
  }
}
