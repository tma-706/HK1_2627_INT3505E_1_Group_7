                  },
                  "INVALID_CURSOR": {
                    "summary": "Cursor sai định dạng, không còn dùng được hoặc khác phạm vi tài khoản hay tab",
                    "value": {
                      "code": "INVALID_CURSOR"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidCoreSession"
          },
          "503": {
            "$ref": "#/components/responses/MyReadUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CoreSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dùng mã phiên do Core cấp trong header Authorization."
      }
    },
    "headers": {
      "AuthNoStore": {
        "required": true,
        "description": "Yêu cầu bên nhận không lưu phản hồi trong cache HTTP.",
        "schema": {
          "type": "string",
          "const": "no-store"
        },
        "example": "no-store"
      }
    },
    "responses": {
      "InvalidCoreSession": {
        "description": "Thiếu mã phiên hợp lệ. Phiên thiếu, sai, hết hạn hoặc bị thu hồi bị từ chối. Xem ngoại lệ xác nhận thu hồi lặp tại revokeCurrentSession.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/AuthError"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "SESSION_INVALID"
                      ]
                    }
                  }
                }
              ]
            },
            "examples": {
              "SESSION_INVALID": {
                "value": {
                  "code": "SESSION_INVALID"
                }
              }
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "required": true,
            "description": "Bearer challenge cho mã phiên Core.",
            "schema": {
              "type": "string",
              "const": "Bearer"
            },
            "example": "Bearer"
          }
        }
      },
      "AuthUnavailable": {
        "description": "Core hoặc phụ thuộc cần thiết cho thao tác tạm thời chưa phục vụ được.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/AuthError"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_UNAVAILABLE"
                      ]
                    }
                  }
                }
              ]
            },
            "examples": {
              "AUTH_UNAVAILABLE": {
                "value": {
                  "code": "AUTH_UNAVAILABLE"
                }
              }
            }
          }
        }
      },
      "MyReadUnavailable": {
        "description": "Core hoặc phụ thuộc cần thiết cho thao tác đọc tạm thời chưa phục vụ được.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/AuthError"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "READ_UNAVAILABLE"
                      ]
                    }
                  }
                }
              ]
            },
            "examples": {
              "READ_UNAVAILABLE": {
                "summary": "Tạm thời không đọc được dữ liệu",
                "value": {
                  "code": "READ_UNAVAILABLE"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "CreateGoogleSessionRequest": {
        "type": "object",
        "required": [
          "idToken",
          "deviceType",
          "attemptId"
        ],
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1,
            "description": "Google ID token của lượt đăng nhập."
          },
          "deviceType": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          },
          "attemptId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID ngẫu nhiên do mobile sinh cho mỗi lượt chọn tài khoản."
          }
        }
      },
      "GoogleSession": {
        "type": "object",
        "required": [
          "sessionToken",
          "accountId",
          "expiresAt"
        ],
        "properties": {
          "sessionToken": {
            "type": "string",
            "minLength": 1,
            "description": "Mã phiên bí mật do Core cấp để gửi qua Bearer."
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "description": "Mã tài khoản nội bộ của Lost & Found."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Mốc hết hiệu lực nếu không có thêm hoạt động thành công. Trong thực nghiệm, lấy mốc sớm hơn giữa 30 ngày từ hoạt động thành công gần nhất và 90 ngày từ lúc cấp phiên."
          }
        }
      },
      "CurrentSession": {
        "type": "object",
        "required": [
          "accountId",
          "expiresAt"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1,
            "description": "Mã tài khoản nội bộ của Lost & Found."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Mốc hết hiệu lực nếu không có thêm hoạt động thành công. Trong thực nghiệm, lấy mốc sớm hơn giữa 30 ngày từ hoạt động thành công gần nhất và 90 ngày từ lúc cấp phiên."
          }
        }
      },
      "AuthError": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã kỹ thuật để mobile chọn cách xử lý và thông báo."
          }
        }
      },
      "MyProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "email",
          "avatarUrl"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Tên đã đồng bộ từ Google."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email đã đồng bộ từ Google."
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "URL ảnh đã đồng bộ từ Google, hoặc null nếu thiếu ảnh."
          }
        }
      },
      "MyPostItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "postedAt",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "ID bài để mở chi tiết cho loại bài tương ứng."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Tiêu đề bài hoặc tên món đồ."
          },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời điểm đăng bài, dùng để sắp xếp theo thời điểm tạo."
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Trạng thái dạng chữ từ fixture trong thực nghiệm."
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL ảnh thu nhỏ nếu có. Với Found, URL chỉ trỏ đến bản đã xử lý riêng tư."
          }
        }
      },
      "MyClaimItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sentAt",
          "status",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "ID ổn định của yêu cầu nhận đồ trong danh sách."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Tên món đồ hoặc tiêu đề bài báo nhặt liên quan."
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời điểm gửi yêu cầu, dùng để sắp xếp theo thời điểm tạo."
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Trạng thái dạng chữ từ fixture trong thực nghiệm."
          },
          "role": {
            "type": "string",
            "enum": [
              "sent",
              "received"
            ],
            "description": "sent hiển thị “Tôi gửi”. received hiển thị “Gửi đến bài của tôi”."
          }
        }
      },
      "MyLostItemsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tab",
          "items",
          "nextCursor"
        ],
        "properties": {
          "tab": {
            "type": "string",
            "const": "lost"
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/MyPostItem"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Giá trị để tải trang kế tiếp, hoặc null khi hết dữ liệu."
          }
        }
      },
      "MyFoundItemsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tab",
          "items",
          "nextCursor"
        ],
        "properties": {
          "tab": {
            "type": "string",
            "const": "found"
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/MyPostItem"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Giá trị để tải trang kế tiếp, hoặc null khi hết dữ liệu."
          }
        }
      },
      "MyClaimsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tab",
          "items",
          "nextCursor"
        ],
        "properties": {
          "tab": {
            "type": "string",
            "const": "claims"
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/MyClaimItem"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Giá trị để tải trang kế tiếp, hoặc null khi hết dữ liệu."
          }
        }
      }
    }
  }
}
