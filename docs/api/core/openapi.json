            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Giá trị nextCursor từ trang trước của cùng tài khoản và tab. Core kiểm tính toàn vẹn và phạm vi của cursor. Client gửi lại nguyên giá trị. Bỏ tham số để bắt đầu từ trang đầu.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "example-lost-next-cursor"
          }
        ],
        "responses": {
