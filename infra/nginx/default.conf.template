map "$request_method:$uri:$http_origin" $feed_admin_origin {
    default "";
    "GET:/api/v1/posts:${LF_ADMIN_ORIGIN}" "${LF_ADMIN_ORIGIN}";
}

map $uri $gateway_log_path {
    default $uri;
    ~^/api/v1/email-request-status/ /api/v1/email-request-status;
}

log_format gateway '$request_method $gateway_log_path $status $request_time';

upstream feed_api {
    zone feed_api 64k;
    resolver 127.0.0.11 valid=2s ipv6=off;
    server ${LF_UPSTREAM}:4010 resolve;
}

server {
    listen 443 ssl;
    server_name localhost 127.0.0.1;
    access_log /var/log/nginx/access.log gateway;

    ssl_certificate /etc/nginx/tls/localhost.crt;
    ssl_certificate_key /etc/nginx/tls/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/v1/ {
        add_header Access-Control-Allow-Origin $feed_admin_origin always;
        add_header Vary Origin always;

        # A proxy_pass without a URI preserves the /api/v1 prefix and query string.
        proxy_pass http://feed_api;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404;
    }
}
