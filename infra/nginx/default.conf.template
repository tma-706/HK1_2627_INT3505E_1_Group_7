upstream feed_api {
    zone feed_api 64k;
    resolver 127.0.0.11 valid=2s ipv6=off;
    server ${LF_UPSTREAM}:4010 resolve;
}

server {
    listen 443 ssl;
    server_name localhost 127.0.0.1;

    ssl_certificate /etc/nginx/tls/localhost.crt;
    ssl_certificate_key /etc/nginx/tls/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/v1/ {
        # A proxy_pass without a URI preserves the /api/v1 prefix and query string.
        proxy_pass http://feed_api;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404;
    }
}
