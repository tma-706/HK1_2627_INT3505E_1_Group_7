# Local Compose values. Change before first initialization if desired.
LF_DB_ADMIN_PASSWORD=local-admin-password
LF_DB_READER_PASSWORD=local-reader-password
LF_CURSOR_SECRET=local-feed-cursor-secret
LF_ADMIN_ORIGIN=http://127.0.0.1:5173
LF_HTTPS_BIND_IP=127.0.0.1
LF_HTTPS_PORT=8443
LF_MEDIA_DB_PASSWORD=local-media-db-password
LF_MEDIA_HTTPS_PORT=8444
LF_MEDIA_UPLOAD_SECONDS=300
LF_S3_ADMIN_ACCESS_KEY=local-provisioner
LF_S3_ADMIN_SECRET_KEY=local-provisioner-secret
LF_S3_ACCESS_KEY=local-core-media
LF_S3_SECRET_KEY=local-core-media-secret
# LF_S3_PUBLIC_ENDPOINT=https://127.0.0.1:8444
LF_IDENTITY_DB_PASSWORD=local-identity-password
LF_IDENTITY_WORKER_DB_PASSWORD=local-identity-worker-password
# Generate once per local stack using node -p "require('node:crypto').randomBytes(32).toString('hex')"
LF_IDENTITY_OUTBOX_KEY=
LF_MAILBOX_PORT=8025
LF_VERIFICATION_LINK_URL=campus-lost-found://verify-email
